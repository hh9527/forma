import "ontology-method/types.telora" as ontology;
import "ontology-method/ontology.telora" as method;

@enum type Entity = { Order: 'None };
@enum type Measure = { Revenue: 'None, Units: 'None };

type MeasureCapability = ontology.Capability(Measure, Entity, String);

let revenue: MeasureCapability = {
    id: 'Revenue,
    lower: fn(entity) { 'Some(`revenue from \{entity}`) },
};

export let output = method.lower_requested(
    ['Revenue, 'Units],
    [revenue],
    fn(item) { item.id },
    fn(item) { item.lower },
    'Order,
);
