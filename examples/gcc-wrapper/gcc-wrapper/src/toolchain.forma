import "std/argv" as argv;
import "std/dict" as dict;
import "std/hash" as hash;
import "std/rt-types/exec.forma" as exec_types;

@struct type Package = {
    name: String,
    src: String,
    digest: String,
};

@struct type ToolchainSource = {
    compilers: Dict(Package),
    sysroots: Dict(Package),
};

type ExecFn = exec_types.ExecFn;

def require: for(A) Fn(Dict(A), String, String) -> A = fn(values, key, message) {
    match dict.get(values, key) {
        'Some(value) => value,
        'None => panic!(message),
    }
};

def source_or_panic: Fn(Any) -> ToolchainSource = fn(raw) {
    match validate(ToolchainSource, raw) {
        'Ok(source) => source,
        'Err(error) => panic!(error.message),
    }
};

def install_dest = fn(settings, package) {
    let identity = `\{package.name}\n\{package.src}\n\{package.digest}`;
    `\{settings.install_prefix}/\{hash.sha256(identity)}`
};

def unpack = fn(package, dest) {
    'Unpack({
        dest,
        ty: 'TarGzip,
        src: package.src,
        strip: 1,
        digest: 'Some(package.digest),
    })
};

def checked_compiler_args = fn(request, sysroot_dest) {
    let arguments = match argv.reject_option(request.args, "--sysroot") {
        'Ok(arguments) => arguments,
        'Err(error) => panic!(error.message),
    };
    let arguments = match argv.reject_option(arguments, "-ffile-prefix-map") {
        'Ok(arguments) => arguments,
        'Err(error) => panic!(error.message),
    };
    let arguments = match argv.reject_option(arguments, "-fdebug-prefix-map") {
        'Ok(arguments) => arguments,
        'Err(error) => panic!(error.message),
    };
    argv.prepend([
        `--sysroot=\{sysroot_dest}`,
        `-ffile-prefix-map=\{request.cwd}=.`,
        `-fdebug-prefix-map=\{request.cwd}=.`,
    ], arguments)
};

export def command: Fn(String, Any) -> ExecFn = fn(tool, raw) {
    let source = source_or_panic(raw);
    # Materialize module definitions before the returned closure is promoted.
    let require_value = require;
    let install_dest_value = install_dest;
    let unpack_value = unpack;
    let checked_compiler_args_value = checked_compiler_args;
    fn(settings, request) {
        let host = `\{settings.platform.os}-\{settings.platform.arch}`;
        let compiler = require_value(source.compilers, host, `unsupported GCC host: \{host}`);
        let compiler_dest = install_dest_value(settings, compiler);
        let compiler_install = unpack_value(compiler, compiler_dest);
        match tool {
            "ar" => {
                install: [compiler_install],
                cwd: 'Some(request.cwd),
                bin: `\{compiler_dest}/bin/ar`,
                args: request.args,
                env: request.env,
            },
            "gcc" => {
                let target: String = require_value(request.env, "TARGET", "TARGET is required");
                let sysroot = require_value(source.sysroots, target, "unsupported GCC target");
                let sysroot_dest = install_dest_value(settings, sysroot);
                {
                    install: [compiler_install, unpack_value(sysroot, sysroot_dest)],
                    cwd: 'Some(request.cwd),
                    bin: `\{compiler_dest}/bin/gcc`,
                    args: checked_compiler_args_value(request, sysroot_dest),
                    env: request.env,
                }
            },
            "g++" => {
                let target: String = require_value(request.env, "TARGET", "TARGET is required");
                let sysroot = require_value(source.sysroots, target, "unsupported GCC target");
                let sysroot_dest = install_dest_value(settings, sysroot);
                {
                    install: [compiler_install, unpack_value(sysroot, sysroot_dest)],
                    cwd: 'Some(request.cwd),
                    bin: `\{compiler_dest}/bin/g++`,
                    args: checked_compiler_args_value(request, sysroot_dest),
                    env: request.env,
                }
            },
            _ => panic!(`unsupported GCC tool: \{tool}`),
        }
    }
};
