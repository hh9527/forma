import "std/argv" as argv;
import "std/dict" as dict;
import "std/hash" as hash;
import "std/rt-types/exec.forma" as exec_types;

@struct type Package = {
    name: String,
    src: String,
    digest: String,
};

@struct type ToolchainSource = {
    compilers: Dict(Package),
    sysroots: Dict(Package),
};

type ExecFn = exec_types.ExecFn;

def require: for(A) Fn(Dict(A), String, String) -> A = fn(values, key, message) {
    match dict.get(values, key) {
        'Some(value) => value,
        'None => panic!(message),
    }
};

def validated_source: Fn(Any) -> ToolchainSource = fn(raw) {
    match validate(ToolchainSource, raw) {
        'Ok(source) => source,
        'Err(error) => reraise!(error),
    }
};

def install_dest = fn(settings, package, ty, strip) {
    let identity = `unpack-v1\n\{package.name}\n\{package.src}\n\{package.digest}\n\{ty}\n\{strip}`;
    `\{settings.install_prefix}/\{hash.sha256(identity)}`
};

def unpack = fn(settings, package, dest, ty, strip) {
    'Unpack({
        dest,
        file: `\{settings.download_prefix}/\{hash.sha256(package.src)}`,
        ty,
        src: package.src,
        strip,
        digest: 'Some(package.digest),
    })
};

def checked_compiler_args = fn(request, sysroot_dest) {
    let arguments = match argv.reject_option(request.args, "--sysroot") {
        'Ok(arguments) => arguments,
        'Err(error) => reraise!(error),
    };
    let arguments = match argv.reject_option(arguments, "-ffile-prefix-map") {
        'Ok(arguments) => arguments,
        'Err(error) => reraise!(error),
    };
    let arguments = match argv.reject_option(arguments, "-fdebug-prefix-map") {
        'Ok(arguments) => arguments,
        'Err(error) => reraise!(error),
    };
    argv.prepend([
        `--sysroot=\{sysroot_dest}`,
        `-ffile-prefix-map=\{request.cwd}=.`,
        `-fdebug-prefix-map=\{request.cwd}=.`,
    ], arguments)
};

export def command: Fn(String, Any) -> ExecFn = fn(tool, raw) {
    let source = validated_source(raw);
    fn(settings, request) {
        let host = `\{settings.platform.os}-\{settings.platform.arch}`;
        let compiler = require(source.compilers, host, `unsupported GCC host: \{host}`);
        let unpack_ty = 'TarGzip;
        let strip = 1;
        let compiler_dest = install_dest(settings, compiler, unpack_ty, strip);
        let compiler_install = unpack(settings, compiler, compiler_dest, unpack_ty, strip);
        match tool {
            "ar" => {
                install: [compiler_install],
                cwd: 'Some(request.cwd),
                bin: `\{compiler_dest}/bin/ar`,
                args: request.args,
                env: {clear: 'False, update: {}},
            },
            "gcc" => {
                let target: String = require(request.env, "TARGET", "TARGET is required");
                let sysroot = require(source.sysroots, target, "unsupported GCC target");
                let sysroot_dest = install_dest(settings, sysroot, unpack_ty, strip);
                {
                    install: [compiler_install, unpack(settings, sysroot, sysroot_dest, unpack_ty, strip)],
                    cwd: 'Some(request.cwd),
                    bin: `\{compiler_dest}/bin/gcc`,
                    args: checked_compiler_args(request, sysroot_dest),
                    env: {clear: 'False, update: {}},
                }
            },
            "g++" => {
                let target: String = require(request.env, "TARGET", "TARGET is required");
                let sysroot = require(source.sysroots, target, "unsupported GCC target");
                let sysroot_dest = install_dest(settings, sysroot, unpack_ty, strip);
                {
                    install: [compiler_install, unpack(settings, sysroot, sysroot_dest, unpack_ty, strip)],
                    cwd: 'Some(request.cwd),
                    bin: `\{compiler_dest}/bin/g++`,
                    args: checked_compiler_args(request, sysroot_dest),
                    env: {clear: 'False, update: {}},
                }
            },
            _ => panic!(`unsupported GCC tool: \{tool}`),
        }
    }
};
