import "./ontology.telora" { compile };
import "./execution.telora" { ExecutionPlan, encode_plan };

let compilation = compile({
    measures: ['NetRevenue],
    dimensions: ['OrderMonth, 'CustomerRegion],
    filters: ['CustomerRegion("East")],
    order_by: ['OrderMonth],
    limit: 'Some(10),
    render: 'Json,
});

let checked: Option(ExecutionPlan) = compilation;

export let output = match checked {
    'Some(plan) => encode_plan(plan),
    'None => "",
};
