import "std/array" as array;
import "ontology-method/ontology.telora" as ontology;

@enum type Entity = {
    Region: 'None,
    Organization: 'None,
    Customer: 'None,
    Order: 'None,
    OrderItem: 'None,
    Product: 'None,
    Category: 'None,
};

@struct type Relation = {
    from: Entity,
    to: Entity,
    table: String,
    alias: String,
    left_alias: String,
    left_column: String,
    right_alias: String,
    right_column: String,
    cardinality: Cardinality,
};

@enum type Cardinality = {
    ManyToOne: 'None,
    OneToMany: 'None,
};

@struct type PathPlan = {
    relations: Array(Relation),
    fanout: Array(Entity),
    missing: Array(Entity),
};

def catalog: Array(Relation) = [
    {from: 'OrderItem, to: 'Order, table: "orders", alias: "o", left_alias: "o", left_column: "id", right_alias: "oi", right_column: "order_id", cardinality: 'ManyToOne},
    {from: 'Order, to: 'Customer, table: "customers", alias: "c", left_alias: "c", left_column: "id", right_alias: "o", right_column: "customer_id", cardinality: 'ManyToOne},
    {from: 'Customer, to: 'Organization, table: "organizations", alias: "org", left_alias: "org", left_column: "id", right_alias: "c", right_column: "org_id", cardinality: 'ManyToOne},
    {from: 'Organization, to: 'Region, table: "regions", alias: "r", left_alias: "r", left_column: "id", right_alias: "org", right_column: "region_id", cardinality: 'ManyToOne},
    {from: 'OrderItem, to: 'Product, table: "products", alias: "product", left_alias: "product", left_column: "id", right_alias: "oi", right_column: "product_id", cardinality: 'ManyToOne},
    {from: 'Product, to: 'Category, table: "categories", alias: "cat", left_alias: "cat", left_column: "id", right_alias: "product", right_column: "category_id", cardinality: 'ManyToOne},
];

def fanout_catalog: Array(Relation) = [
    {from: 'Order, to: 'OrderItem, table: "order_items", alias: "oi", left_alias: "oi", left_column: "order_id", right_alias: "o", right_column: "id", cardinality: 'OneToMany},
];

def contains: Fn(Array(Entity), Entity) -> Bool = fn(values, expected) {
    ontology.contains(values, expected)
};

def relation_from: Fn(Relation) -> Entity = fn(relation) { relation.from };
def relation_to: Fn(Relation) -> Entity = fn(relation) { relation.to };

def plan: Fn(Entity, Array(Entity)) -> PathPlan = fn(base, targets) {
    let needed = ontology.close_six(catalog, targets, relation_to, relation_from);
    let safe_reachable = ontology.close_six(catalog, [base], relation_from, relation_to);
    let all = array.concat([catalog, fanout_catalog]);
    let all_reachable = ontology.close_six(all, [base], relation_from, relation_to);
    {
        relations: ontology.select_connecting_edges(
            catalog, safe_reachable, needed, relation_from, relation_to,
        ),
        fanout: array.filter(targets, fn(target) {
            contains(safe_reachable, target) == 'False && contains(all_reachable, target)
        }),
        missing: array.filter(targets, fn(target) { contains(all_reachable, target) == 'False }),
    }
};

export { Entity, Cardinality, Relation, PathPlan, plan };
