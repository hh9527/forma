import "./ontology.telora" { compile };

let compilation = compile({
    measures: ['NetRevenue],
    alignment: 'Natural,
    dimensions: ['OrderMonth, 'CustomerRegion],
    filters: [],
    order_by: ['OrderMonth, 'CustomerRegion],
    limit: 'Some(10),
    render: {mode: 'Table, fields: ["order_month", "customer_region", "net_revenue_cents"]},
});

export let output = match compilation {
    'Some(plan) => plan.statement,
    'None => panic!("expected the valid report to lower to SQL"),
};
