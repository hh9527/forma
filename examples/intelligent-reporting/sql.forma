import "std/array" as array;
import "std/string" as string;

@enum type Function = {
    Coalesce: 'None,
    Substr: 'None,
    Sum: 'None,
};

@enum type BinaryOp = {
    Equal: 'None,
    NotEqual: 'None,
    Subtract: 'None,
};

@struct type Column = { relation: String, name: String };

@enum type SqlAtom = {
    Column: Column,
    Int: Int,
    Text: String,
};

@struct type Call = { function: Function, args: Array(SqlAtom) };

@enum type SqlTerm = {
    Atom: SqlAtom,
    Call: Call,
};

@struct type Binary = { left: SqlTerm, op: BinaryOp, right: SqlTerm };

@enum type SqlScalar = {
    Term: SqlTerm,
    Binary: Binary,
};

@struct type Aggregate = { function: Function, value: SqlScalar };

@enum type SqlSelectExpr = {
    Scalar: SqlScalar,
    Aggregate: Aggregate,
};

@struct type Projection = { expr: SqlSelectExpr, alias: Option(String) };
@struct type Source = { name: String, alias: String };

@enum type JoinKind = { Inner: 'None, Left: 'None };
@struct type Join = { kind: JoinKind, source: Source, on: SqlScalar };
@struct type Order = { expr: SqlScalar };

@struct type SelectBody = {
    projections: Array(Projection),
    from: Source,
    joins: Array(Join),
    filter: Option(SqlScalar),
    group_by: Array(SqlScalar),
    order_by: Array(Order),
};

@struct type CommonTable = { name: String, query: SelectBody };
@struct type Select = { common_tables: Array(CommonTable), body: SelectBody };

def quote_identifier: Fn(String) -> String = fn(value) {
    `"\{string.replace(value, "\"", "\"\"")}"`
};

def quote_text: Fn(String) -> String = fn(value) {
    `'\{string.replace(value, "'", "''")}'`
};

def render_function: Fn(Function) -> String = fn(value) {
    match value { 'Coalesce => "COALESCE", 'Substr => "substr", 'Sum => "SUM" }
};

def render_binary_op: Fn(BinaryOp) -> String = fn(value) {
    match value { 'Equal => "=", 'NotEqual => "!=", 'Subtract => "-" }
};

def render_atom: Fn(SqlAtom) -> String = fn(value) {
    match value {
        'Column(column) => `\{quote_identifier(column.relation)}.\{quote_identifier(column.name)}`,
        'Int(number) => `\{number}`,
        'Text(text) => quote_text(text),
    }
};

def render_call: Fn(Call) -> String = fn(value) {
    `\{render_function(value.function)}(\{string.join(array.map(value.args, render_atom), ", ")})`
};

def render_term: Fn(SqlTerm) -> String = fn(value) {
    match value { 'Atom(atom) => render_atom(atom), 'Call(call) => render_call(call) }
};

def render_scalar: Fn(SqlScalar) -> String = fn(value) {
    match value {
        'Term(term) => render_term(term),
        'Binary(binary) => `(\{render_term(binary.left)} \{render_binary_op(binary.op)} \{render_term(binary.right)})`,
    }
};

def render_select_expr: Fn(SqlSelectExpr) -> String = fn(value) {
    match value {
        'Scalar(scalar) => render_scalar(scalar),
        'Aggregate(aggregate) => `\{render_function(aggregate.function)}(\{render_scalar(aggregate.value)})`,
    }
};

def render_projection: Fn(Projection) -> String = fn(value) {
    let rendered = render_select_expr(value.expr);
    match value.alias {
        'Some(alias) => `\{rendered} AS \{quote_identifier(alias)}`,
        'None => rendered,
    }
};

def render_source: Fn(Source) -> String = fn(value) {
    `\{quote_identifier(value.name)} AS \{quote_identifier(value.alias)}`
};

def render_join: Fn(Join) -> String = fn(value) {
    let keyword = match value.kind { 'Inner => "JOIN", 'Left => "LEFT JOIN" };
    `\{keyword} \{render_source(value.source)} ON \{render_scalar(value.on)}`
};

def render_body: Fn(SelectBody) -> String = fn(value) {
    let projections = string.join(array.map(value.projections, render_projection), ",\n       ");
    let joins = if array.length(value.joins) == 0 { "" } else {
        `\n\{string.join(array.map(value.joins, render_join), "\n")}`
    };
    let filter = match value.filter {
        'Some(expr) => `\nWHERE \{render_scalar(expr)}`,
        'None => "",
    };
    let groups = if array.length(value.group_by) == 0 { "" } else {
        `\nGROUP BY \{string.join(array.map(value.group_by, render_scalar), ", ")}`
    };
    let orders = if array.length(value.order_by) == 0 { "" } else {
        `\nORDER BY \{string.join(array.map(value.order_by, fn(item) { render_scalar(item.expr) }), ", ")}`
    };
    `SELECT \{projections}\nFROM \{render_source(value.from)}\{joins}\{filter}\{groups}\{orders}`
};

def render_select: Fn(Select) -> String = fn(value) {
    let common = if array.length(value.common_tables) == 0 { "" } else {
        let rendered = array.map(value.common_tables, fn(item) {
            `\{quote_identifier(item.name)} AS (\n\{string.indent(render_body(item.query), 2)}\n)`
        });
        `WITH \{string.join(rendered, ",\n")}\n`
    };
    `\{common}\{render_body(value.body)};`
};

export {
    Function, BinaryOp, SqlAtom, SqlTerm, SqlScalar, SqlSelectExpr, Projection, Source,
    JoinKind, Join, Order, SelectBody, CommonTable, Select, render_select,
};
