import "std/array" as array;
import "std/string" as string;

@enum type Function = {
    Coalesce: 'None,
    Substr: 'None,
    Sum: 'None,
};

@enum type BinaryOp = {
    Equal: 'None,
    NotEqual: 'None,
    GreaterEqual: 'None,
    Subtract: 'None,
};

@struct type Column = { relation: String, name: String };

@struct type Call = { function: Function, args: Array(Expr) };
@struct type Binary = { left: Expr, op: BinaryOp, right: Expr };
@struct type Aggregate = { function: Function, value: Expr };

@enum type Expr = {
    Column: Column,
    Int: Int,
    Text: String,
    Call: Call,
    Binary: Binary,
    Aggregate: Aggregate,
};

@struct type Projection = { expr: Expr, alias: Option(String) };
@struct type Source = { name: String, alias: String };

@enum type JoinKind = { Inner: 'None, Left: 'None };
@struct type Join = { kind: JoinKind, source: Source, on: Expr };
@struct type Order = { expr: Expr };

@struct type SelectBody = {
    projections: Array(Projection),
    from: Source,
    joins: Array(Join),
    filters: Array(Expr),
    group_by: Array(Expr),
    order_by: Array(Order),
    limit: Option(Int),
};

@struct type CommonTable = { name: String, query: SelectBody };
@struct type Select = { common_tables: Array(CommonTable), body: SelectBody };

def quote_identifier: Fn(String) -> String = fn(value) {
    `"\{string.replace(value, "\"", "\"\"")}"`
};

def quote_text: Fn(String) -> String = fn(value) {
    `'\{string.replace(value, "'", "''")}'`
};

def render_function: Fn(Function) -> String = fn(value) {
    match value { 'Coalesce => "COALESCE", 'Substr => "substr", 'Sum => "SUM" }
};

def render_binary_op: Fn(BinaryOp) -> String = fn(value) {
    match value { 'Equal => "=", 'NotEqual => "!=", 'GreaterEqual => ">=", 'Subtract => "-" }
};

def render_expr: Fn(Expr) -> String = fn(value) {
    match value {
        'Column(column) => `\{quote_identifier(column.relation)}.\{quote_identifier(column.name)}`,
        'Int(number) => `\{number}`,
        'Text(text) => quote_text(text),
        'Call(call) => `\{render_function(call.function)}(\{string.join(array.map(call.args, render_expr), ", ")})`,
        'Binary(binary) => `(\{render_expr(binary.left)} \{render_binary_op(binary.op)} \{render_expr(binary.right)})`,
        'Aggregate(aggregate) => `\{render_function(aggregate.function)}(\{render_expr(aggregate.value)})`,
    }
};

def render_projection: Fn(Projection) -> String = fn(value) {
    let rendered = render_expr(value.expr);
    match value.alias {
        'Some(alias) => `\{rendered} AS \{quote_identifier(alias)}`,
        'None => rendered,
    }
};

def render_source: Fn(Source) -> String = fn(value) {
    `\{quote_identifier(value.name)} AS \{quote_identifier(value.alias)}`
};

def render_join: Fn(Join) -> String = fn(value) {
    let keyword = match value.kind { 'Inner => "JOIN", 'Left => "LEFT JOIN" };
    `\{keyword} \{render_source(value.source)} ON \{render_expr(value.on)}`
};

def render_body: Fn(SelectBody) -> String = fn(value) {
    let projections = string.join(array.map(value.projections, render_projection), ",\n       ");
    let joins = if array.length(value.joins) == 0 { "" } else {
        `\n\{string.join(array.map(value.joins, render_join), "\n")}`
    };
    let filters = if array.length(value.filters) == 0 { "" } else {
        `\nWHERE \{string.join(array.map(value.filters, render_expr), " AND ")}`
    };
    let groups = if array.length(value.group_by) == 0 { "" } else {
        `\nGROUP BY \{string.join(array.map(value.group_by, render_expr), ", ")}`
    };
    let orders = if array.length(value.order_by) == 0 { "" } else {
        `\nORDER BY \{string.join(array.map(value.order_by, fn(item) { render_expr(item.expr) }), ", ")}`
    };
    let limit = match value.limit { 'Some(count) => `\nLIMIT \{count}`, 'None => "" };
    `SELECT \{projections}\nFROM \{render_source(value.from)}\{joins}\{filters}\{groups}\{orders}\{limit}`
};

def render_select: Fn(Select) -> String = fn(value) {
    let common = if array.length(value.common_tables) == 0 { "" } else {
        let rendered = array.map(value.common_tables, fn(item) {
            `\{quote_identifier(item.name)} AS (\n\{string.indent(render_body(item.query), 2)}\n)`
        });
        `WITH \{string.join(rendered, ",\n")}\n`
    };
    `\{common}\{render_body(value.body)};`
};

export {
    Function, BinaryOp, Expr, Projection, Source,
    JoinKind, Join, Order, SelectBody, CommonTable, Select, render_select,
};
