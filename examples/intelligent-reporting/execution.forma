import "std/json" as json;

@enum type SqlDialect = { Sqlite: 'None };
@enum type OutputMode = { Table: 'None, Json: 'None };

@struct type ExecutionPlan = {
    version: Int,
    dialect: SqlDialect,
    statement: String,
    read_only: Bool,
    output: OutputMode,
};

def encode_plan: Fn(ExecutionPlan) -> String = fn(plan) {
    let dialect = match plan.dialect { 'Sqlite => "sqlite" };
    let output = match plan.output { 'Table => "table", 'Json => "json" };
    json.stringify({
        version: plan.version,
        dialect,
        statement: plan.statement,
        read_only: plan.read_only,
        output,
    })
};

export { SqlDialect, OutputMode, ExecutionPlan, encode_plan };
