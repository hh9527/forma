import "std/array" as array;
import "./sql.forma" {
    Function,
    BinaryOp,
    SqlAtom,
    SqlTerm,
    SqlScalar,
    SqlSelectExpr,
    Projection,
    Source,
    JoinKind,
    Join,
    Order,
    CommonTable,
    SelectBody,
    Select,
    render_select,
};
import "./relations.forma" { Entity, Relation, PathPlan, plan };

@enum type Measure = {
    NetRevenue: 'None,
    UnitsSold: 'None,
};

@enum type Dimension = {
    OrderMonth: 'None,
    CustomerRegion: 'None,
    OrganizationKind: 'None,
    ProductCategory: 'None,
    EmployeeKind: 'None,
    ProductSku: 'None,
};

@struct type ReportIntent = {
    measures: Array(Measure),
    dimensions: Array(Dimension),
};

@struct type QueryPlan = {
    measure: Measure,
    base_entity: Entity,
    required_entities: Array(Entity),
    common_tables: Array(CommonTable),
    from: Source,
    joins: Array(Join),
    filter: Option(SqlScalar),
    measure_projection: Projection,
};

@struct type GroupRequirement = {
    projection: Projection,
    group_expression: SqlScalar,
    required_entity: Entity,
};

@struct type RequirementCompilation = {
    requirement: Option(GroupRequirement),
    diagnostics: Array(BlameError),
};

@struct type Compilation = {
    sql: Option(String),
    diagnostics: Array(BlameError),
};

type MeasureLowerer = Fn() -> QueryPlan;
type DimensionLowerer = Fn(Measure) -> RequirementCompilation;

@struct type MeasureCapability = {
    id: Measure,
    lower: MeasureLowerer,
};

@struct type DimensionCapability = {
    id: Dimension,
    lower: DimensionLowerer,
};

def complete_requirement: Fn(Projection, SqlScalar, Entity) -> RequirementCompilation = fn(projected, group_expression, required_entity) {
    {
        requirement: 'Some({projection: projected, group_expression, required_entity}),
        diagnostics: [],
    }
};

def rejected_requirement: Fn(Dimension, String) -> RequirementCompilation = fn(value, message) {
    {
        requirement: 'None,
        diagnostics: [blame!(value, message)],
    }
};

# A higher-order compiler factory: construct a dimension capability whose
# lowering is valid for every current measure.
def universal_dimension: Fn(Dimension, Projection, SqlScalar, Entity) -> DimensionCapability = fn(id, projected, group_expression, required_entity) {
    {
        id,
        lower: fn(measure) {
            complete_requirement(projected, group_expression, required_entity)
        },
    }
};

# A second compiler factory: construct a capability restricted to one measure.
# The same function both verifies the semantic edge and lowers it.
def measure_dimension: Fn(Dimension, Measure, Projection, SqlScalar, Entity) -> DimensionCapability = fn(id, required_measure, projected, group_expression, required_entity) {
    {
        id,
        lower: fn(actual_measure) {
            if actual_measure == required_measure {
                complete_requirement(projected, group_expression, required_entity)
            } else {
                rejected_requirement(
                    id,
                    `dimension \{id} is not compatible with measure \{actual_measure} at its current grain`,
                )
            }
        },
    }
};

def unsupported_dimension: Fn(Dimension, String) -> DimensionCapability = fn(id, reason) {
    {
        id,
        lower: fn(measure) {
            rejected_requirement(id, `dimension \{id} is not available: \{reason}`)
        },
    }
};

def column: Fn(String, String) -> SqlAtom = fn(relation, name) {
    'Column({relation, name})
};

def call: Fn(Function, Array(SqlAtom)) -> SqlTerm = fn(function, args) {
    'Call({function, args})
};

def binary: Fn(SqlTerm, BinaryOp, SqlTerm) -> SqlScalar = fn(left, op, right) {
    'Binary({left, op, right})
};

def term: Fn(SqlAtom) -> SqlTerm = fn(value) { 'Atom(value) };
def scalar: Fn(SqlTerm) -> SqlScalar = fn(value) { 'Term(value) };

def projection: Fn(SqlScalar, String) -> Projection = fn(expr, alias) {
    {expr: 'Scalar(expr), alias: 'Some(alias)}
};

def aggregate_projection: Fn(Function, SqlScalar, String) -> Projection = fn(function, value, alias) {
    {expr: 'Aggregate({function, value}), alias: 'Some(alias)}
};

def source: Fn(String, String) -> Source = fn(name, alias) { {name, alias} };

def join: Fn(JoinKind, Source, SqlScalar) -> Join = fn(kind, joined_source, on) {
    {kind, source: joined_source, on}
};

def relation_join: Fn(Relation) -> Join = fn(relation) {
    join(
        'Inner,
        source(relation.table, relation.alias),
        equals(
            column(relation.left_alias, relation.left_column),
            column(relation.right_alias, relation.right_column),
        ),
    )
};

def equals: Fn(SqlAtom, SqlAtom) -> SqlScalar = fn(left, right) {
    binary(term(left), 'Equal, term(right))
};

def payment_by_order: SelectBody = {
    projections: [
        projection(scalar(term(column("payments", "order_id"))), "order_id"),
        aggregate_projection('Sum, scalar(term(column("payments", "amount_cents"))), "captured_cents"),
    ],
    from: source("payments", "payments"),
    joins: [],
    filter: 'Some(equals(column("payments", "status"), 'Int(2))),
    group_by: [scalar(term(column("payments", "order_id")))],
    order_by: [],
};

def refund_by_order: SelectBody = {
    projections: [
        projection(scalar(term(column("payments", "order_id"))), "order_id"),
        aggregate_projection('Sum, scalar(term(column("refunds", "amount_cents"))), "refunded_cents"),
    ],
    from: source("refunds", "refunds"),
    joins: [join(
        'Inner,
        source("payments", "payments"),
        equals(column("payments", "id"), column("refunds", "payment_id")),
    )],
    filter: 'Some(equals(column("refunds", "status"), 'Int(2))),
    group_by: [scalar(term(column("payments", "order_id")))],
    order_by: [],
};

def net_revenue: MeasureCapability = {
    id: 'NetRevenue,
    lower: fn() {
        {
            measure: 'NetRevenue,
            base_entity: 'Order,
            required_entities: [],
            common_tables: [
                {name: "payment_by_order", query: payment_by_order},
                {name: "refund_by_order", query: refund_by_order},
            ],
            from: source("orders", "o"),
            joins: [
                join('Left, source("payment_by_order", "p"), equals(column("p", "order_id"), column("o", "id"))),
                join('Left, source("refund_by_order", "f"), equals(column("f", "order_id"), column("o", "id"))),
            ],
            filter: 'Some(equals(column("o", "status"), 'Int(2))),
            measure_projection: aggregate_projection(
                'Sum,
                binary(
                    call('Coalesce, [column("p", "captured_cents"), 'Int(0)]),
                    'Subtract,
                    call('Coalesce, [column("f", "refunded_cents"), 'Int(0)]),
                ),
                "net_revenue_cents",
            ),
        }
    },
};

def units_sold: MeasureCapability = {
    id: 'UnitsSold,
    lower: fn() {
        {
            measure: 'UnitsSold,
            base_entity: 'OrderItem,
            required_entities: ['Order],
            common_tables: [],
            from: source("order_items", "oi"),
            joins: [],
            filter: 'Some(binary(term(column("o", "status")), 'NotEqual, term('Int(3)))),
            measure_projection: aggregate_projection('Sum, scalar(term(column("oi", "quantity"))), "units_sold"),
        }
    },
};

def measure_capability: Fn(Measure) -> MeasureCapability = fn(measure) {
    match measure {
        'NetRevenue => net_revenue,
        'UnitsSold => units_sold,
    }
};

def dimension_capability: Fn(Dimension) -> DimensionCapability = fn(dimension) {
    match dimension {
        'OrderMonth => universal_dimension(
            dimension,
            projection(scalar(call('Substr, [column("o", "ordered_at"), 'Int(1), 'Int(7)])), "order_month"),
            scalar(call('Substr, [column("o", "ordered_at"), 'Int(1), 'Int(7)])),
            'Order,
        ),
        'CustomerRegion => universal_dimension(
            dimension,
            projection(scalar(term(column("r", "name"))), "customer_region"),
            scalar(term(column("r", "name"))),
            'Region,
        ),
        'OrganizationKind => measure_dimension(
            dimension,
            'NetRevenue,
            projection(scalar(term(column("org", "kind"))), "organization_kind"),
            scalar(term(column("org", "kind"))),
            'Organization,
        ),
        'ProductCategory => measure_dimension(
            dimension,
            'UnitsSold,
            projection(scalar(term(column("cat", "name"))), "product_category"),
            scalar(term(column("cat", "name"))),
            'Category,
        ),
        'EmployeeKind => unsupported_dimension(
            dimension,
            "the ontology has no verified Employee-to-measure relation",
        ),
        'ProductSku => measure_dimension(
            dimension,
            'UnitsSold,
            projection(scalar(term(column("product", "sku"))), "product_sku"),
            scalar(term(column("product", "sku"))),
            'Product,
        ),
    }
};

def measure_diagnostics: Fn(ReportIntent) -> Array(BlameError) = fn(intent) {
    if array.length(intent.measures) == 1 {
        []
    } else {
        [blame!(intent.measures, "the initial compiler requires exactly one measure")]
    }
};

def selected_measure: Fn(ReportIntent) -> Measure = fn(intent) {
    match array.find(intent.measures, fn(ignored) { 'True }) {
        'Some(measure) => measure,
        'None => 'NetRevenue,
    }
};

def compile_requirements: Fn(Measure, Array(Dimension)) -> Array(RequirementCompilation) = fn(measure, dimensions) {
    array.map(dimensions, fn(dimension) {
        let capability = dimension_capability(dimension);
        capability.lower(measure)
    })
};

def requirement_diagnostics: Fn(Array(RequirementCompilation)) -> Array(BlameError) = fn(compilations) {
    array.flat_map(compilations, fn(compilation) {
        compilation.diagnostics
    })
};

def successful_requirements: Fn(Array(RequirementCompilation)) -> Array(GroupRequirement) = fn(compilations) {
    array.flat_map(compilations, fn(compilation) {
        match compilation.requirement {
            'Some(requirement) => [requirement],
            'None => [],
        }
    })
};

def finalize_sql: Fn(QueryPlan, Array(GroupRequirement)) -> String = fn(query_plan, requirements) {
    let groups = array.map(requirements, fn(requirement) { requirement.group_expression });
    let targets = array.concat([
        query_plan.required_entities,
        array.map(requirements, fn(requirement) { requirement.required_entity }),
    ]);
    let paths = plan(query_plan.base_entity, targets);
    render_select({
        common_tables: query_plan.common_tables,
        body: {
            projections: array.push(
                array.map(requirements, fn(requirement) { requirement.projection }),
                query_plan.measure_projection,
            ),
            from: query_plan.from,
            joins: array.concat([query_plan.joins, array.map(paths.relations, relation_join)]),
            filter: query_plan.filter,
            group_by: groups,
            order_by: array.map(groups, fn(expr) { {expr} }),
        },
    })
};

export def compile: Fn(ReportIntent) -> Compilation = fn(intent) {
    let measure = selected_measure(intent);
    let capability = measure_capability(measure);
    let plan = capability.lower();
    let requirement_compilations = compile_requirements(measure, intent.dimensions);
    let diagnostics = array.concat([
        measure_diagnostics(intent),
        requirement_diagnostics(requirement_compilations),
    ]);
    if array.length(diagnostics) == 0 {
        {
            sql: 'Some(finalize_sql(plan, successful_requirements(requirement_compilations))),
            diagnostics,
        }
    } else {
        {sql: 'None, diagnostics}
    }
};

export {
    Measure,
    Dimension,
    ReportIntent,
    Compilation,
    MeasureCapability,
    DimensionCapability,
};
