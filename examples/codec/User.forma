import "core:codec" as codec;
import "core:result" as result;

@struct
type Type = {v: Option(String)};

let decode = fn(value) {
    codec.decode(Type, value)
};

let encode = fn(value) {
    codec.encode(Type, value) |> result.unwrap
};

{
    Type: Type,
    decode: decode,
    encode: encode,
}
