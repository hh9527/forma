import "std/array" as array;
import "std/string" as string;

def matches_option: Fn(String, String) -> Bool = fn(argument, option) {
    argument == option || string.starts_with(argument, `\{option}=`)
};
let matches = matches_option;

def contains_option: Fn(Array(String), String) -> Bool = fn(arguments, option) {
    array.any(arguments, fn(argument) { matches(argument, option) })
};

def reject_option:
    Fn(Array(String), String) -> Result(Array(String), BlameError) =
    fn(arguments, option) {
        match array.find(arguments, fn(argument) { matches(argument, option) }) {
            'None => 'Ok(arguments),
            'Some(argument) => 'Err(blame!(argument, `conflicting argument: \{option}`)),
        }
    };

def prepend: Fn(Array(String), Array(String)) -> Array(String) = fn(prefix, arguments) {
    array.concat([prefix, arguments])
};

export { matches_option, contains_option, reject_option, prepend };
