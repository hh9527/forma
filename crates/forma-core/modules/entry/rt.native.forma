native type ModuleHandle @1;
native type InstantiatedModule @2;
native module_options: Fn(ModuleHandle) -> Array(Any);
native option_names: Fn(Any) -> Result(Array(String), BlameError);
native capture_vars: Fn(ModuleHandle, Array(String)) -> Dict(String);
native args: Fn(ModuleHandle) -> Array(String);
native cwd: Fn(ModuleHandle) -> String;
native var: Fn(ModuleHandle, String) -> Option(String);
native platform: Fn(ModuleHandle) -> Any;
native download_prefix: Fn(ModuleHandle) -> String;
native install_prefix: Fn(ModuleHandle) -> String;
native initialize_module:
    Fn(ModuleHandle) -> Result(InstantiatedModule, BlameError);
native module_export:
    Fn(InstantiatedModule, String) -> Result(Dyn, BlameError);
native check_type:
    for(A) Fn(TypeOf(A), Dyn) -> Result(A, BlameError);

export {
    ModuleHandle,
    InstantiatedModule,
    module_options,
    option_names,
    capture_vars,
    args,
    cwd,
    var,
    platform,
    download_prefix,
    install_prefix,
    initialize_module,
    module_export,
    check_type,
};
